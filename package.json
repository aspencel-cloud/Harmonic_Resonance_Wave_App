{
  "name": "harmonic-wave-wheel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://aspencel-cloud.github.io/Harmonic_Resonance_Wave_App/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html','dist/404.html'))\"",
    "preview": "vite preview --port 5173 --strictPort --base /Harmonic_Resonance_Wave_App/ --open /Harmonic_Resonance_Wave_App/",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "validate:decans": "node tools/validate-decans.mjs",
    "check:decans": "node tools/decans-smoke.mjs",
    "build:waves": "node tools/build-waves.mjs",
    "validate:waves": "node tools/validate-waves.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.2.7",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint-plugin-prettier": "^5.5.4",
    "gh-pages": "^6.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
